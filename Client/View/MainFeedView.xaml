<Window x:Class="lumentra.View.MainFeedView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:UserControl="clr-namespace:lumentra.View.UserControl"
        xmlns:local="clr-namespace:lumentra.View"
        mc:Ignorable="d"
        Title="Lumentra" Height="450" Width="800"
        ThemeMode="Dark"
        WindowState="Maximized">
    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="360"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            Margin="10,0,0,0">
                    <Image Source="/lumentra;component/Assets/Images/LogoModified.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="15,0,5,0"
                           Height="30"/>
                    <TextBlock Text="lumentra"
                               VerticalAlignment="Center"
                               FontSize="30"
                               FontStyle="Italic"
                               FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF4169E1" Offset="0.0"/>
                                <!-- Royal Blue -->
                                <GradientStop Color="#FF8A2BE2" Offset="1.0"/>
                                <!-- Blue Violet -->
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>

                

                    <StackPanel Grid.Row="1">
                        <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,60,0,10"
                                Click="HomeButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE80F;"
                                           FontSize="24"
                                           Margin="0,0,8,0"/>

                                <TextBlock Text="Home"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10"
                                Click="ExploreButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE721;"
                                                       FontSize="24"
                                                       Margin="0,0,8,0"/>

                                <TextBlock Text="Explore"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10" FontSize="28"
                                Click="NotificationButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE7EE;"
                                           FontSize="24"
                                           Margin="0,0,8,0"/>

                                <TextBlock Text="Notifications"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10"
                                Click="ProfileButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE77B;"
                                           FontSize="22"
                                           Margin="0,0,8,0"/>

                                <TextBlock Text="Profile"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10"
                                Click="CollectionButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE14C;"
                                           FontSize="24"
                                           Margin="0,5,8,0"/>

                                <TextBlock Text="Collections"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10"
                                Click="UploadButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE898;"
                                           FontSize="24"
                                           Margin="0,3,8,0"/>

                                <TextBlock Text="Uploads"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                <Button Grid.Row="2"
                        Style="{StaticResource LogoutButtonStyle}"
                        Width="150"
                        Height="40"
                        Click="LogoutButton_Click">
                    <TextBlock Text="Logout"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                </Button>
                
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource ChromeSearchBox}" 
                         Width="400" 
                         Height="40" 
                         VerticalAlignment="Center"
                         KeyDown="SearchBox_KeyDown"/>

                <ScrollViewer Grid.Row="1">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ChromeScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Orientation="Vertical">
                        <Border CornerRadius="15" Height="250"
                            Margin="20" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.4"/>
                            </Border.Effect>

                            <Border.Background>
                                <ImageBrush ImageSource="/lumentra;component/Assets/Images/Feedbanner.jpg"
                                        Stretch="UniformToFill"
                                        Viewbox="0,0.01,1,1"
                                        ViewboxUnits="RelativeToBoundingBox"/>
                            </Border.Background>
                            <StackPanel VerticalAlignment="Bottom" Margin="20">
                                <TextBlock Text="PREMIUM EXPERIENCE" Foreground="#FF4169E1" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="Unlock Exclusive Contents" Foreground="DimGray" FontSize="24" FontWeight="Bold"/>
                                <Button Content="Subscribe Now" Style="{StaticResource LogoutButtonStyle}" Width="140" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Click="SubscribeButton_Click"/>
                            </StackPanel>

                        </Border>

                        <TextBlock Text="Recommended for You"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="20,10,0,10"/>

                        <ItemsControl x:Name ="VideoFeed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <UserControl:VideoCards Loaded="VideoCards_Loaded"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Column="2">
                <Border CornerRadius="10"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Margin="8"
                        MaxHeight="800">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF1A1A1A" Offset="0.0"/>
                            <GradientStop Color="#FF121212" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel>
                        <Border CornerRadius="8"
                                Margin="2,2,2,2"
                                Height="150">
                            <Border.Background>
                                <ImageBrush x:Name="CourseThumbnail"
                                    />
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="CourseTitle"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="FloralWhite"/>
                        <TextBlock x:Name="CourseAuthor"
                                   FontSize="15"
                                   Foreground="#AAAAAA"
                                   FontWeight="Light"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CourseViews"
                                       FontSize="12"
                                       Foreground="#777777"/>
                            <TextBlock x:Name="CourseSeparator1"
                                       Text=" • "
                                       FontSize="12"
                                       Foreground="#777777"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="CourseRatings"
                                       FontSize="12"
                                       Foreground="#777777"/>
                            <TextBlock x:Name="CourseSeparator2"
                                       Text=" • "
                                       FontSize="12"
                                       Foreground="#777777"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="CourseDuration"
                                       Foreground="#777777"
                                       FontSize="12"/>
                        </StackPanel>
                        <Button x:Name="BuyNow_Button"
                                Content="Buy Now"
                                Style="{StaticResource LogoutButtonStyle}"
                                Width="90"
                                Height="35"
                                HorizontalAlignment="Right"
                                Margin="0,30,5,0"
                                Click="BuyNow_Button_Click"
                                Visibility="Collapsed"/>
                        
                        <StackPanel Margin="0,10,0,0"
                                    x:Name="CourseInfo"
                                    Visibility="Collapsed">
                            <TextBlock Text="Course Description"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock x:Name="CourseDescription"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="Anything"/>
                            <Border CornerRadius="8"
                                    HorizontalAlignment="Left"
                                    Padding="10,5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF4169E1" Offset="0.0"/>
                                        <!-- Royal Blue -->
                                        <GradientStop Color="#FF8A2BE2" Offset="1.0"/>
                                        <!-- Blue Violet -->
                                    </LinearGradientBrush>
                                </Border.Background>
                                    
                            <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CoursePrice"
                                               FontSize="16"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="1"
        CornerRadius="15"
        Margin="20,5,20,15"
        Height="70"
        ClipToBounds="True">
            <!-- Outer Glow Effect -->
            <Border.Effect>
                <DropShadowEffect Color="#FF4169E1" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF4169E1" Offset="0.0"/>
                    <!-- Royal Blue -->
                    <GradientStop Color="#FFF34F67" Offset="1.0"/>
                    <!-- Coral Red -->
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Text with subtle shadow for readability -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                    <TextBlock Text="SPECIAL OFFER:" 
                       Foreground="White" 
                       FontSize="12" 
                       FontWeight="Black" 
                       Opacity="0.8"
                       VerticalAlignment="Center"
                       Margin="0,3,10,0"/>
                    <TextBlock Text="Get 50% off your first subscription"
                       FontSize="22"
                       Foreground="White"
                       FontWeight="Bold"
                       VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.2"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- 2. The Coupon "Pill" -->
                <Border Grid.Column="1" 
                Background="#30000000" 
                BorderBrush="#40FFFFFF" 
                BorderThickness="1.5"
                CornerRadius="10" 
                Margin="0,0,20,0"
                Padding="15,8"
                VerticalAlignment="Center"
                Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Code: " Foreground="White" Opacity="0.7" FontSize="14"/>
                        <TextBlock Text="LUMENTRA50" Foreground="White" FontWeight="Black" FontSize="16"/>
                        <TextBlock Text=" &#xE8C8;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
