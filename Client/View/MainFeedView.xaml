<Window x:Class="lumentra.View.MainFeedView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lumentra.View"
        mc:Ignorable="d"
        Title="Lumentra" Height="450" Width="800"
        ThemeMode="System"
        WindowState="Maximized">
    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="360"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            Margin="10,0,0,0">
                    <Image Source="/lumentra;component/Assets/Images/LogoModified.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="15,0,5,0"
                           Height="30"/>
                    <TextBlock Text="Lumentra"
                               VerticalAlignment="Center"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="FloralWhite"/>
                </StackPanel>

                

                    <StackPanel Grid.Row="1">
                        <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,60,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE80F;"
                                           FontSize="24"
                                           Margin="0,0,8,0"/>

                                <TextBlock Text="Home"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE721;"
                                                       FontSize="24"
                                                       Margin="0,0,8,0"/>

                                <TextBlock Text="Explore"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10" FontSize="28">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE7EE;"
                                           FontSize="24"
                                           Margin="0,0,8,0"/>

                                <TextBlock Text="Notifications"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE77B;"
                                           FontSize="22"
                                           Margin="0,0,8,0"/>

                                <TextBlock Text="Profile"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE14C;"
                                           FontSize="24"
                                           Margin="0,5,8,0"/>

                                <TextBlock Text="Collections"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE898;"
                                           FontSize="24"
                                           Margin="0,3,8,0"/>

                                <TextBlock Text="Uploads"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                <Button Grid.Row="2"
                        Style="{StaticResource LogoutButtonStyle}"
                        Width="150"
                        Height="40">
                    <TextBlock Text="Logout"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                </Button>
                
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="270"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox Style="{StaticResource ChromeSearchBox}" 
                         Width="400" 
                         Height="40" 
                         
                         VerticalAlignment="Center"/>

                <ScrollViewer Grid.Row="1">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ChromeScrollBar}"/>
                    </ScrollViewer.Resources>
                    <Border CornerRadius="15" 
                            Margin="20" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.4"/>
                        </Border.Effect>

                        <Border.Background>
                            <ImageBrush ImageSource="/lumentra;component/Assets/Images/Feedbanner.jpg"
                                        Stretch="UniformToFill"
                                        Viewbox="0,0.01,1,1"
                                        ViewboxUnits="RelativeToBoundingBox"/>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Bottom" Margin="20">
                            <TextBlock Text="PREMIUM EXPERIENCE" Foreground="#FF4169E1" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="Unlock Exclusive Contents" Foreground="DimGray" FontSize="24" FontWeight="Bold"/>
                            <Button Content="Subscribe Now" Style="{StaticResource LogoutButtonStyle}" Width="140" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel>

                    </Border>
                    
                    
                </ScrollViewer>
                


            </Grid>
        </Grid>
        <Border Grid.Row="1"
                CornerRadius="20"
                Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF4169E1" Offset="0.0"/>
                    <!-- Royal Blue -->
                    <GradientStop Color="#FF8A2BE2" Offset="1.0"/>
                    <!-- Blue Violet -->
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Now Playing"
                               VerticalAlignment="Top"
                               FontSize="16"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="GhostWhite"
                               Margin="15,5,0,0"/>
                    <TextBlock Text="Song Title - Artist Name"
                               Margin="15,5,0,0"
                               FontFamily="Segoe UI"
                               FontWeight="ExtraBold"
                               Foreground="Black"
                               FontSize="20"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Seek Left (Back 10s) -->
                    <Button Content="&#xE892;" Style="{StaticResource GlassPlaybackButton}"/>

                    <!-- Pause Button (Larger) -->
                    <Button Content="&#xE768;" 
                            Style="{StaticResource GlassPlaybackButton}" 
                            Width="60" Height="60" FontSize="24">
                        <Button.Resources>
                            <!-- Overriding radius for the larger play button -->
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="30"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Seek Right (Forward 10s) -->
                    <Button Content="&#xE893;" Style="{StaticResource GlassPlaybackButton}"
             FontFamily="Segoe MDL2 Assets"/>
                </StackPanel>
            </Grid>
           

        </Border>
    </Grid>
</Window>
