<Window x:Class="lumentra.View.ContentBrowserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Content Browser" Height="550" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0"
                Height="36"
                CornerRadius="0,0,0,0"
                BorderThickness="0,0,0,1"
                BorderBrush="#191919"
                Background="#121212">


            <!-- Subtle Depth -->
            <Border.Effect>
                <DropShadowEffect Color="#191919"
                          BlurRadius="6"
                          ShadowDepth="1"
                          Opacity="0.3"/>
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                    VerticalAlignment="Center"
                    Margin="15,0,0,0"
                    FontSize="14"
                    Foreground="AntiqueWhite"
                    Text="Lumentra"/>

                <Button Grid.Column="2"
                         Name="maximize_btn"
                         Content="&#xE922;"
                         FontFamily="Segoe MDL2 Assets"
                         FontSize="12"
                         Foreground="AntiqueWhite"
                         ToolTip="Min/Max"
                         Click="WinMin_Click"
                         BorderThickness="0"
                         Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                     Width="30"
                                     Height="20"
                                     CornerRadius="5"
                                     Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RecognizesAccessKey="True"
                                           Content="{TemplateBinding Content}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="3"
                        Name="close_btn"
                        Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Foreground="AntiqueWhite"
                        ToolTip="Close"
                        Click="WinClose_Click"
                        BorderThickness="0"
                        Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Width="30"
                                    Height="20"
                                    CornerRadius="5"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  Content="{TemplateBinding Content}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="MediumVioletRed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="1"
                        Name="minimize_btn"
                        Content="&#xE921;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Foreground="AntiqueWhite"
                        ToolTip="Minimize"
                        Click="WinMinimize_Click"
                        BorderThickness="0"
                        Background="Transparent">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                             Width="30"
                             Height="20"
                             CornerRadius="5"
                             Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RecognizesAccessKey="True"
                                           Content="{TemplateBinding Content}"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                     Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                     Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
        </Border>
        <Grid Grid.Row="1" Background="#191919">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Glossy Sidebar -->
            <Border Grid.Column="0"
                    Margin="10"
                    CornerRadius="20"
                    BorderThickness="1"
                    BorderBrush="#33334D">

                <!-- Main Gradient Background -->
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <!-- Slight shine at left -->
                        <GradientStop Color="#2A2A2A" Offset="0"/>
                        <GradientStop Color="#1F1F1F" Offset="0.3"/>

                        <!-- Main dark color -->
                        <GradientStop Color="#151515" Offset="0.7"/>

                        <!-- Subtle shine at right -->
                        <GradientStop Color="#1C1C1C" Offset="1"/>
                    </LinearGradientBrush>

                </Border.Background>

                <!-- Shadow -->
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                          BlurRadius="12"
                          ShadowDepth="0"
                          Opacity="0.35"/>
                </Border.Effect>

                <Grid>
                    <!-- Glass highlight overlay -->
                    <Border Height="60"
                VerticalAlignment="Top"
                CornerRadius="20,20,0,0"
                IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#33FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Content -->
                    <StackPanel>

                        <!-- Logo Header -->
                        <StackPanel Orientation="Horizontal"
                        Margin="20,20,20,10"
                        VerticalAlignment="Top">

                            <Border Width="44"
                        Height="44"
                        CornerRadius="22"
                        Background="Transparent"
                        VerticalAlignment="Center">
                                <Image Source="/lumentra;component/Assets/Images/LogoLumentra.png"
                           Width="34"
                           Height="34"
                           Stretch="Uniform"/>
                            </Border>

                            <TextBlock Text="Lumentra"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Divider -->
                        <Border Height="1"
                    Margin="20,10"
                    Background="#33FFFFFF"/>

                        <!-- Sidebar Buttons -->
                        <StackPanel Margin="10,10,10,0">
                            <Button Style="{StaticResource GlossySidebarButton}"
                                    Margin="0,10,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE80F;"
                                               FontSize="26"
                                               Margin="0,0,14,0"/>

                                    <TextBlock Text="Home"
                                               FontSize="24"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlossySidebarButton}"
                                    Margin="0,10,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE721;"
                                               FontSize="26"
                                               Margin="0,0,14,0"/>

                                    <TextBlock Text="Explore"
                                               FontSize="24"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlossySidebarButton}"
                                    Margin="0,10,0,10" FontSize="28">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE7EE;"
                                               FontSize="26"
                                               Margin="0,0,14,0"/>

                                    <TextBlock Text="Notifications"
                                               FontSize="24"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlossySidebarButton}"
                                    Margin="0,10,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE77B;"
                                               FontSize="26"
                                               Margin="0,0,14,0"/>

                                    <TextBlock Text="Profile"
                                               FontSize="24"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GlossySidebarButton}"
                                    Margin="0,10,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE14C;"
                                               FontSize="26"
                                               Margin="0,5,14,0"/>

                                    <TextBlock Text="Collections"
                                               FontSize="24"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GlossySidebarButton}"
                                    Margin="0,10,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE898;"
                                               FontSize="26"
                                               Margin="0,3,14,0"/>
                                    
                                    <TextBlock Text="Uploads"
                                           FontSize="24"
                                           FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>
            <!-- Main Feed -->
            <Grid Grid.Column="1"
                  Background="#191919">
                <ScrollViewer VerticalScrollBarVisibility="Visible"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="10">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ChromeScrollBar}"/>
                    </ScrollViewer.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Border Height="36"
                                    Width="500"
                                    Margin="0,0,0,10"
                                    CornerRadius="18"
                                    Background="#252533"
                                    Padding="10"
                                    VerticalAlignment="Top">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search TextBox -->
                                    <TextBox Grid.Column="0"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="White"
                                             FontSize="14"
                                             VerticalContentAlignment="Center"
                                             Padding="0"
                                             x:Name="SearchBox"
                                             Text="Search..."
                                             GotFocus="SearchBox_GotFocus"
                                             LostFocus="SearchBox_LostFocus"/>

                                    <!-- Search Icon -->
                                    <Button Width="40" Height="18"
                                            Background="Transparent"
                                            Template="{StaticResource PlainRoundedButton}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="19,0,0,0">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE721;" 
                                                   FontSize="15" 
                                                   Foreground="White" 
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center"/>
                                    </Button>

                                </Grid>
                            </Border>
                            
                        </StackPanel>
                        
                    </Grid>

                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
