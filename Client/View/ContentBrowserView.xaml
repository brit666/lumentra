<Window x:Class="lumentra.View.ContentBrowserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Content Browser" Height="550" Width="900"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        MouseDown="Window_MouseDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0"
                Height="36"
        CornerRadius="20,20,0,0"
        BorderThickness="0,0,0,1"
        BorderBrush="#1E1E2F">

            <!-- Dark Gradient -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1C1C2E" Offset="0"/>
                    <GradientStop Color="#151525" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- Subtle Depth -->
            <Border.Effect>
                <DropShadowEffect Color="#66000000"
                          BlurRadius="6"
                          ShadowDepth="1"
                          Opacity="0.3"/>
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                    VerticalAlignment="Center"
                    Margin="15,0,0,0"
                    FontSize="14"
                    Foreground="AntiqueWhite"
                    Text="Lumentra"/>

                <Button Grid.Column="2"
                 Name="maximize_btn"
                 Content="&#xE922;"
                 FontFamily="Segoe MDL2 Assets"
                 FontSize="12"
                 Foreground="AntiqueWhite"
                 ToolTip="Close"
                 Click="WinMin_Click"
                 BorderThickness="0"
                 Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                             Width="30"
                             Height="20"
                             CornerRadius="5"
                             Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RecognizesAccessKey="True"
                                           Content="{TemplateBinding Content}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="3"
            Name="close_btn"
            Content="&#xE8BB;"
            FontFamily="Segoe MDL2 Assets"
            FontSize="12"
            Foreground="AntiqueWhite"
            ToolTip="Close"
            Click="WinClose_Click"
            BorderThickness="0"
            Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                         Width="30"
                         Height="20"
                         CornerRadius="5"
                         Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RecognizesAccessKey="True"
                           Content="{TemplateBinding Content}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="MediumVioletRed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="1"
                 Name="minimize_btn"
                 Content="&#xE921;"
                 FontFamily="Segoe MDL2 Assets"
                 FontSize="12"
                 Foreground="AntiqueWhite"
                 ToolTip="Minimize"
                 Click="WinMinimize_Click"
                 BorderThickness="0"
                 Background="Transparent">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                             Width="30"
                             Height="20"
                             CornerRadius="5"
                             Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RecognizesAccessKey="True"
                                           Content="{TemplateBinding Content}"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                     Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                     Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Glossy Sidebar -->
            <Border Grid.Column="0"
        Margin="10"
        CornerRadius="20"
        BorderThickness="1"
        BorderBrush="#33334D">

                <!-- Main Gradient Background -->
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1E1E2F" Offset="0"/>
                        <GradientStop Color="#161625" Offset="0.5"/>
                        <GradientStop Color="#10101A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <!-- Shadow -->
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                          BlurRadius="12"
                          ShadowDepth="0"
                          Opacity="0.35"/>
                </Border.Effect>

                <Grid>
                    <!-- Glass highlight overlay -->
                    <Border Height="60"
                VerticalAlignment="Top"
                CornerRadius="20,20,0,0"
                IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#33FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Content -->
                    <StackPanel>

                        <!-- Logo Header -->
                        <StackPanel Orientation="Horizontal"
                        Margin="20,20,20,10"
                        VerticalAlignment="Top">

                            <Border Width="44"
                        Height="44"
                        CornerRadius="22"
                        Background="Transparent"
                        VerticalAlignment="Center">
                                <Image Source="/lumentra;component/Assets/Images/LogoLumentra.png"
                           Width="34"
                           Height="34"
                           Stretch="Uniform"/>
                            </Border>

                            <TextBlock Text="Lumentra"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Divider -->
                        <Border Height="1"
                    Margin="20,10"
                    Background="#33FFFFFF"/>

                        <!-- Sidebar Buttons -->
                        <StackPanel Margin="10,10,10,0">
                            <Button Style="{StaticResource GlossySidebarButton}"
                                    Margin="40,10,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE80F;"
                                               FontSize="26"
                                               Margin="0,0,14,0"/>

                                    <TextBlock Text="Home"
                                               FontSize="24"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Explore" Style="{StaticResource GlossySidebarButton}"
                                    Margin="40,10,0,10"/>
                            <Button Content="Notifications" Style="{StaticResource GlossySidebarButton}"
                                    Margin="40,10,0,10" FontSize="28"/>
                            <Button Content="Profile" Style="{StaticResource GlossySidebarButton}"
                                    Margin="40,10,0,10"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>


            <!-- Main Feed -->
            <ScrollViewer Grid.Column="1" Margin="10,10,10,10">
                <StackPanel>
                    <!-- Example Feed Cards -->
                    <Border Margin="0,0,0,15" CornerRadius="15" Padding="15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#2A2A50" Offset="0"/>
                                <GradientStop Color="#1F1F3B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="Feed Item 1" Foreground="White" FontSize="16"/>
                    </Border>

                    <Border Margin="0,0,0,15" CornerRadius="15" Padding="15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#2A2A50" Offset="0"/>
                                <GradientStop Color="#1F1F3B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="Feed Item 2" Foreground="White" FontSize="16"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
