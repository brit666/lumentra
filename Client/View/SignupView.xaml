<Window x:Class="lumentra.View.SignupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SignupView"
        Height="600"
        Width="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown"
        Background="Transparent"
        AllowsTransparency="True">

    <Border BorderThickness="5"
            CornerRadius="40">
        <Border.Background>
            <ImageBrush ImageSource="/lumentra;component/Assets/Images/LoginBackground.png"
                        Stretch="UniformToFill"/>
        </Border.Background>

        <Border BorderThickness="3"
                CornerRadius="30">

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#ff00ff" Offset="0"/>
                    <GradientStop Color="#0000ff" Offset="0.75"/>
                    <GradientStop Color="#00ffff" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF10054A" Offset="0"/>
                    <GradientStop Color="#DD28163A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="10"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="15,0,0,0"
                   FontSize="14"
                   Foreground="AntiqueWhite"
                   Text="Lumentra - Login"/>

                        <Button Grid.Column="2"
                Content="&#xE8BB;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="12"
                Foreground="AntiqueWhite"
                ToolTip="Close"
                Click="WinClose_Click"
                BorderThickness="0"
                Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                            Width="30"
                            Height="20"
                            CornerRadius="5"
                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          Content="{TemplateBinding Content}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="MediumVioletRed"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="1"
                Content="&#xE921;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="12"
                Foreground="AntiqueWhite"
                ToolTip="Minimize"
                Click="WinMinimize_Click"
                BorderThickness="0"
                Background="Transparent">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                            Width="30"
                            Height="20"
                            CornerRadius="5"
                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          Content="{TemplateBinding Content}"/>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background"
                                    Value="#33FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background"
                                    Value="#55FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </Grid>

                    <!-- Signup Form -->
                <StackPanel Grid.Row="1"
                            Width="250"
                            Margin="0,35,0,0">

                    <Image Source="/lumentra;component/Assets/Images/LogoLumentra.png"
                           Width="100"
                           Height="100"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="Create Account"
                               FontSize="28"
                               FontFamily="Times New Roman"
                               Foreground="AntiqueWhite"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>

                    <!-- Username -->
                    <TextBlock Text="Username"
                    Foreground="DarkGray"
                    FontSize="12"
                    FontWeight="Medium"
                    FontFamily="Montserrat"
                    Margin="0,20,0,0"/>

                    <TextBox x:Name="txtUser"
                     FontSize="13"
                     FontWeight="Medium"
                     FontFamily="Montserrat"
                     Foreground="White"
                     CaretBrush="LightGray"
                     BorderBrush="DarkGray"
                     BorderThickness="0,0,0,2"
                     Height="28"
                     VerticalContentAlignment="Center"
                     Margin="0,5,0,0"
                     Padding="20,0,0,0">    
                        <TextBox.Background>
                            <ImageBrush ImageSource="/lumentra;component/Assets/Images/UserIcon.png"
                    Stretch="Uniform"
                    AlignmentX="Left"
                    Viewport="2,5,16,16"
                    ViewportUnits="Absolute"/>
                        </TextBox.Background>
                    </TextBox>

                    <!-- Email -->
                    <TextBlock Text="Email"
                    Foreground="DarkGray"
                    FontSize="12"
                    FontWeight="Medium"
                    FontFamily="Montserrat"
                    Margin="0,15,0,0"/>

                    <TextBox x:Name="txtEmail"
                    FontSize="13"
                    FontWeight="Medium"
                    FontFamily="Montserrat"
                    Foreground="White"
                    CaretBrush="LightGray"
                    BorderBrush="DarkGray"
                    BorderThickness="0,0,0,2"
                    Height="28"
                    VerticalContentAlignment="Center"
                    Margin="0,5,0,0"
                    Padding="20,0,0,0" TextChanged="txtEmail_TextChanged">
                    <TextBox.Background>
                            <ImageBrush ImageSource="/lumentra;component/Assets/Images/EmailIcon.png"
                    Stretch="Uniform"
                    AlignmentX="Left"
                    Viewport="-1,5,24,24"
                    ViewportUnits="Absolute"/>
                        </TextBox.Background>
                    </TextBox>

                    <TextBlock x:Name="txtEmailWarning"
                     Text="Please enter a valid email address"
                     Foreground="IndianRed"
                     FontSize="10"
                     FontFamily="Montserrat"
                     Margin="2,2,0,0"
                     Visibility="Collapsed"/>

                    <!-- Password -->
                    <TextBlock Text="Password"
           Foreground="DarkGray"
           FontSize="12"
           FontWeight="Medium"
           FontFamily="Montserrat"
           Margin="0,15,0,0"/>

                    <PasswordBox x:Name="txtPass"
             FontSize="13"
             FontWeight="Medium"
             FontFamily="Montserrat"
             Foreground="White"
             CaretBrush="LightGray"
             BorderBrush="DarkGray"
             BorderThickness="0,0,0,2"
             Height="28"
             VerticalContentAlignment="Center"
             Margin="0,5,0,0"
             Padding="20,0,0,0">
                        <PasswordBox.Background>
                            <ImageBrush ImageSource="/lumentra;component/Assets/Images/PasswordIcon.png"
                    Stretch="Uniform"
                    AlignmentX="Left"
                    Viewport="2,5,16,16"
                    ViewportUnits="Absolute"/>
                        </PasswordBox.Background>
                    </PasswordBox>

                    <!-- Confirm Password -->
                    <TextBlock Text="Confirm Password"
           Foreground="DarkGray"
           FontSize="12"
           FontWeight="Medium"
           FontFamily="Montserrat"
           Margin="0,15,0,0"/>


             <PasswordBox x:Name="txtConfirmPass"
             FontSize="13"
             FontWeight="Medium"
             FontFamily="Montserrat"
             Foreground="White"
             CaretBrush="LightGray"
             BorderBrush="DarkGray"
             BorderThickness="0,0,0,2"
             Height="28"
             VerticalContentAlignment="Center"
             Margin="0,5,0,25"
             Padding="20,0,0,0"
             PasswordChanged="txtConfirmPass_PasswordChanged">
                        <PasswordBox.Background>
                            <ImageBrush ImageSource="/lumentra;component/Assets/Images/PasswordIcon.png"
                    Stretch="Uniform"
                    AlignmentX="Left"
                    Viewport="2,5,16,16"
                    ViewportUnits="Absolute"/>
                        </PasswordBox.Background>
                    </PasswordBox>
           <TextBlock x:Name="txtConfirmPassWarning"
           Text="Passwords do not match"
           Foreground="IndianRed"
           FontSize="10"
           FontFamily="Montserrat"
           Margin="2,2,0,0"
           Visibility="Collapsed"/>



                    <!-- Sign Up Button -->
                    <Button Content="SIGN UP"
                            Height="40"
                            Width="150"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Foreground="White"
                            FontFamily="Montserrat"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#462AD8"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#28AEED"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="20"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Login Redirect -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,15,0,0">
                        <TextBlock Text="Already have an account?"
                                   Foreground="DarkGray"
                                   FontSize="12"/>
                        <TextBlock Text="Login"
                                   Foreground="White"
                                   FontSize="12"
                                   Cursor="Hand"
                                   Margin="6,0,0,0"
                                   MouseLeftButtonDown="login_MouseLeftButtonDown"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
