<UserControl x:Class="lumentra.View.UserControl.NotificationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:lumentra.View.UserControl"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="750">
    <Border Background="#252525" 
            BorderBrush="#353535" 
            BorderThickness="1" 
            CornerRadius="22" 
            Padding="12"
            Margin="5,0,0,10">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- Hover effect to make it feel interactive -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#303030"/>
                        <Setter Property="BorderBrush" Value="#FF4169E1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="45"/>
                <!-- Avatar/Icon -->
                <ColumnDefinition Width="*"/>
                <!-- Content -->
            </Grid.ColumnDefinitions>

            <!-- 1. Creator Avatar or System Icon -->
            <Border Width="35" Height="35" CornerRadius="18" VerticalAlignment="Top">
                <Image Source="/lumentra;component/Assets/Images/UserIcon.png">
                    <!-- Fallback Icon if no image -->
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <Trigger Property="Source" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Border>

            <!-- 2. Text Content -->
            <StackPanel Grid.Column="1" Margin="10,0,5,0">
                <TextBlock Text="{Binding NotificationTitle}" 
                           Foreground="White" 
                           FontWeight="Bold" 
                           FontSize="13" 
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding NotificationMessage}" 
                           Foreground="#B0B0B0" 
                           FontSize="15" 
                           Margin="0,2,0,5" 
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding NotificationTimeStamp}" 
                           Foreground="#666" 
                           FontSize="10"/>
            </StackPanel>
        
        </Grid>
    </Border>
</UserControl>
