<UserControl x:Class="lumentra.View.UserControl.VideoSearchCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:lumentra.View.UserControl"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="600">
    <Border CornerRadius="8" 
            Background="#181818" 
            Padding="8"
            Cursor="Hand"
            MouseLeftButtonUp="Border_MouseLeftButtonUp">

        <!-- Hover effect -->
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thumbnail -->
            <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True">
                <Image x:Name="ThumbnailImage" Stretch="UniformToFill"/>
            </Border>

            <!-- Video Info -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                <!-- Video Title -->
                <TextBlock x:Name="VideoTitle"
                           Text="Video Title"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           MaxHeight="40"/>

                <!-- Channel Name -->
                <TextBlock x:Name="VideoChannel"
                           Text="Channel Name"
                           FontSize="13"
                           Foreground="#AAAAAA"
                           Margin="0,4,0,0"/>

                <!-- Views and Duration -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="VideoViews" Text="123K views" FontSize="12" Foreground="#777777"/>
                    <TextBlock Text=" • " FontSize="12" Foreground="#777777" Margin="2,0"/>
                    <TextBlock x:Name="VideoDuration" Text="4:30" FontSize="12" Foreground="#777777"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
