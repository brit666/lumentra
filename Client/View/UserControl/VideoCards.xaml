<UserControl x:Class="lumentra.View.UserControl.VideoCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:lumentra.View.UserControl"
             mc:Ignorable="d" 
             d:DesignHeight="270" d:DesignWidth="350">
    <Border Width="320"
        CornerRadius="12"
        Background="#181818"
        Margin="10"
        Cursor="Hand"
        RenderTransformOrigin="0.5,0.5"
        MouseLeftButtonUp="Border_MouseLeftButtonUp"
        MouseLeftButtonDown="Border_MouseLeftButtonDown"
        MouseEnter="Border_MouseEnter"
        MouseLeave="Border_MouseLeave">

        <!-- Drop Shadow -->
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow" 
                          BlurRadius="10"
                          ShadowDepth="2"
                          Opacity="0.25"
                          Color="Black"/>
        </Border.Effect>

        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <StackPanel>

            <!-- Thumbnail -->
            <Grid Height="180" ClipToBounds="True">
                <Border CornerRadius="12,12,0,0">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding ThumbnailUri}"
                                Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- Info -->
            <StackPanel Margin="10">

                <!-- Title -->
                <TextBlock Text="{Binding VideoTitle}"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       MaxHeight="40"/>

                <!-- Channel -->
                <TextBlock Text="{Binding VideoAuthor}"
                       Foreground="#AAAAAA"
                       FontSize="12"
                       Margin="0,6,0,0"/>

                <!-- Meta -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding VideoViews}"
                               Foreground="#777777"
                               FontSize="11"/>
                    <TextBlock Text=" • "
                               Foreground="#777777"
                               FontSize="11"/>
                    <TextBlock Text="{Binding VideoRatings}"
                               Foreground="#777777"
                               FontSize="11"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>
