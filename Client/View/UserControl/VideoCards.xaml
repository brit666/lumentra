<UserControl x:Class="lumentra.View.UserControl.VideoCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:lumentra.View.UserControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Width="320"
        CornerRadius="12"
        Background="#181818"
        Margin="10"
        Cursor="Hand">

        <!-- Drop Shadow -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="10"
                          ShadowDepth="2"
                          Opacity="0.25"
                          Color="Black"/>
        </Border.Effect>

        <StackPanel>

            <!-- Thumbnail -->
            <Grid Height="180" ClipToBounds="True">
                <Border CornerRadius="12,12,0,0">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding ThumbnailUrl}"
                                Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <!-- Duration -->
                <Border Background="#CC000000"
                    CornerRadius="4"
                    Padding="6,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="8">
                    <TextBlock Text="12:34"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- Info -->
            <StackPanel Margin="10">

                <!-- Title -->
                <TextBlock Text="TEST TITLE"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       MaxHeight="40"/>

                <!-- Channel -->
                <TextBlock Text="Lumentra Dev"
                       Foreground="#AAAAAA"
                       FontSize="12"
                       Margin="0,6,0,0"/>

                <!-- Meta -->
                <TextBlock Text="52K views • 2 days ago"
                       Foreground="#777777"
                       FontSize="11"/>
            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>
