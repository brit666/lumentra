<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GlassPlaybackButton" TargetType="Button">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="10,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- The Glass Circle -->
                    <Border x:Name="bg" 
                        CornerRadius="25" 
                        Background="#25FFFFFF" 
                        BorderBrush="#40FFFFFF" 
                        BorderThickness="1">
                        <TextBlock x:Name="icon"
                               Text="{TemplateBinding Content}" 
                               FontFamily="Segoe MDL2 Assets" 
                               FontSize="18"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Get brighter -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#40FFFFFF"/>
                            <Setter TargetName="bg" Property="BorderBrush" Value="#80FFFFFF"/>
                        </Trigger>
                        <!-- Click: Scale down slightly -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="bg" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>