<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="NavTabButtonStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="45"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#888"/>
        <!-- Dimmed when inactive -->
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        CornerRadius="8" 
                        Margin="5,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <!-- The Indicator Bar -->
                                <ColumnDefinition Width="40"/>
                                <!-- Icon -->
                                <ColumnDefinition Width="*"/>
                                <!-- Text -->
                            </Grid.ColumnDefinitions>

                            <!-- Active Indicator Bar -->
                            <Border x:Name="activeIndicator" 
                                Background="#FF4169E1" 
                                CornerRadius="2" 
                                Margin="0,10" 
                                Visibility="Collapsed"/>

                            <!-- Icon -->
                            <TextBlock Grid.Column="1" 
                                   Text="{TemplateBinding Tag}" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   FontSize="18" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"/>

                            <!-- Label -->
                            <ContentPresenter Grid.Column="2" 
                                          VerticalAlignment="Center" 
                                          Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#252525"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>

                        <!-- Selected State (Checked) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="#1A4169E1"/>
                            <!-- Subtle Blue Tint -->
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>