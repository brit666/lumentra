<Window x:Class="lumentra.View.UploadsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:UserControl="clr-namespace:lumentra.View.UserControl"
        Title="My Uploads" Height="550" Width="800"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"        
        Background="Transparent" AllowsTransparency="True">

    <Border Background="#1A1A1A" BorderThickness="3" CornerRadius="30">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#ff00ff" Offset="0.0"/>
                <GradientStop Color="#0000ff" Offset="0.75"/>
                <GradientStop Color="#00ffff" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Upload Action Bar -->
                <RowDefinition Height="*"/>
                <!-- List -->
            </Grid.RowDefinitions>

            <!-- 1. Header Area -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="My Uploads" FontSize="16" FontWeight="Bold" 
                           Foreground="AntiqueWhite" Margin="20,0,0,0" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" 
                        FontSize="12" Foreground="AntiqueWhite" Click="WinClose_Click"
                        Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Margin="0,0,20,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Width="30" Height="20" CornerRadius="5" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="MediumVioletRed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. "Upload New" Action Section -->
            <Border Grid.Row="1" Margin="20,10,20,10" Padding="15" 
                    Background="#252525" CornerRadius="15" BorderBrush="#333" BorderThickness="1">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Manage your content" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Upload new videos or edit your existing library" Foreground="Gray" FontSize="12"/>
                    </StackPanel>

                    <!-- Reusing your LogoutButtonStyle for the Upload Button -->
                    <Button Content="+ Upload New Video" Style="{StaticResource LogoutButtonStyle}" 
                            Width="160" Height="40" HorizontalAlignment="Right" Click="UploadNew_Click"/>
                </Grid>
            </Border>

            <!-- 3. Scrollable Uploads List -->
            <ScrollViewer Grid.Row="2" Margin="15,0,5,15">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ChromeScrollBar}"/>
                </ScrollViewer.Resources>

                <ItemsControl x:Name="UploadsFeed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Reusing VideoCards; you can later add "Edit/Delete" overlays here -->
                            <UserControl:VideoCards Margin="5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
