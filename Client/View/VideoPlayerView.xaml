<Window x:Class="lumentra.View.VideoPlayerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:lumentra.View"
        mc:Ignorable="d"
        Title="VideoPlayerView" Height="450" Width="800"
        ThemeMode="Dark"
        WindowState="Maximized"
        Closing="Window_Closing">

    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="360"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal"
                        Margin="10,0,0,0">
                    <Image Source="/lumentra;component/Assets/Images/LogoModified.png"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="15,0,5,0"
                       Height="30"/>
                    <TextBlock Text="lumentra"
                           VerticalAlignment="Center"
                           FontSize="30"
                           FontStyle="Italic"
                           FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF4169E1" Offset="0.0"/>
                                <!-- Royal Blue -->
                                <GradientStop Color="#FF8A2BE2" Offset="1.0"/>
                                <!-- Blue Violet -->
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>



                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource GlossySidebarButton}"
                            Margin="0,60,0,10"
                            Click="HomeButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE80F;"
                                       FontSize="24"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="Home"
                                       FontSize="20"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GlossySidebarButton}"
                            Margin="0,10,0,10"
                            Click="ExploreButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE721;"
                                                   FontSize="24"
                                                   Margin="0,0,8,0"/>

                            <TextBlock Text="Explore"
                                       FontSize="20"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GlossySidebarButton}"
                            Margin="0,10,0,10" FontSize="28"
                            Click="NotificationButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE7EE;"
                                       FontSize="24"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="Notifications"
                                       FontSize="20"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GlossySidebarButton}"
                            Margin="0,10,0,10"
                            Click="ProfileButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE77B;"
                                       FontSize="22"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="Profile"
                                       FontSize="20"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlossySidebarButton}"
                            Margin="0,10,0,10"
                            Click="CollectionButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE14C;"
                                       FontSize="24"
                                       Margin="0,5,8,0"/>

                            <TextBlock Text="Collections"
                                       FontSize="20"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlossySidebarButton}"
                            Margin="0,10,0,10"
                            Click="UploadButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE898;"
                                       FontSize="24"
                                       Margin="0,3,8,0"/>

                            <TextBlock Text="Uploads"
                                       FontSize="20"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Row="2"
                    Style="{StaticResource LogoutButtonStyle}"
                    Width="150"
                    Height="40"
                    Click="LogoutButton_Click">
                    <TextBlock Text="Logout"
                           FontSize="16"
                           FontWeight="SemiBold"/>
                </Button>

            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox"
                     Style="{StaticResource ChromeSearchBox}" 
                     Width="400" 
                     Height="40" 
                     VerticalAlignment="Center"
                     KeyDown="SearchBox_KeyDown"/>
                <Grid Grid.Row="1"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Stretch">
                    <Border Background="Black"
                            CornerRadius="3"
                            ClipToBounds="True"
                            MaxHeight="450"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                        <vlc:VideoView x:Name="VideoPlayer"
                                       Height="600"
                                       Width="900"/>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="2"
                              Margin="10,30,10,10">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ChromeScrollBar}"/>
                    </ScrollViewer.Resources>
                    <TextBlock Text="Comments"
                               FontSize="20"
                               Foreground="White"
                               Margin="10,10,10,10"/>

                    <TextBox x:Name="CommentInputBox"
                             Style="{StaticResource ChromeSearchBox}"
                             Width="Auto"
                             Height="40"
                             VerticalAlignment="Center"
                             Margin="10,0,10,10"
                             KeyDown="CommentInputBox_KeyDown"/>
                </ScrollViewer>

                
            </Grid>
            <Grid Grid.Column="2">
                <Border CornerRadius="10"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Margin="8"
                    MaxHeight="800">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF1A1A1A" Offset="0.0"/>
                            <GradientStop Color="#FF121212" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel>

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="1"
            CornerRadius="20"
            Margin="0,0,0,10"
            MaxHeight="70">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF4169E1" Offset="0.0"/>
                    <!-- Royal Blue -->
                    <GradientStop Color="#FFF34F67" Offset="1.0"/>
                    <!-- Blue Violet -->
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Now Playing"
                           VerticalAlignment="Top"
                           FontSize="16"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           Foreground="GhostWhite"
                           Margin="15,5,0,0"/>
                    <TextBlock Text="Song Title - Artist Name"
                           Margin="15,5,0,0"
                           FontFamily="Segoe UI"
                           FontWeight="ExtraBold"
                           Foreground="Black"
                           FontSize="20"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Seek Left (Back 10s) -->
                    <Button Content="&#xE892;" Style="{StaticResource GlassPlaybackButton}"
                            Click="SeekLeft_Click"/>

                    <!-- Pause Button (Larger) -->
                    <Button x:Name="PauseButton" 
                        Content="&#xE769;" 
                        Style="{StaticResource GlassPlaybackButton}" 
                        Width="60" Height="60" FontSize="24"
                        Click="Pause_Click">
                        <Button.Resources>
                            <!-- Overriding radius for the larger play button -->
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="30"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Seek Right (Forward 10s) -->
                    <Button Content="&#xE893;" Style="{StaticResource GlassPlaybackButton}"
                            FontFamily="Segoe MDL2 Assets"
                            Click="SeekRight_Click"/>
                </StackPanel>
            </Grid>


        </Border>
    </Grid>

</Window>
