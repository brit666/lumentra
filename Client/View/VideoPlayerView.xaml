<Window x:Class="lumentra.View.VideoPlayerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:lumentra.View"
        mc:Ignorable="d"
        Title="VideoPlayerView" Height="450" Width="800"
        ThemeMode="Dark"
        WindowState="Maximized"
        Closing="Window_Closing">

    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="360"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal"
                        Margin="10,0,0,0">
                    <Image Source="/lumentra;component/Assets/Images/LogoModified.png"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="15,0,5,0"
                       Height="30"/>
                    <TextBlock Text="lumentra"
                           VerticalAlignment="Center"
                           FontSize="30"
                           FontStyle="Italic"
                           FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF4169E1" Offset="0.0"/>
                                <!-- Royal Blue -->
                                <GradientStop Color="#FF8A2BE2" Offset="1.0"/>
                                <!-- Blue Violet -->
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>



                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource GlossySidebarButton}"
                            Margin="0,60,0,10"
                            Click="HomeButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE80F;"
                                       FontSize="24"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="Home"
                                       FontSize="20"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GlossySidebarButton}"
                            Margin="0,10,0,10"
                            Click="ExploreButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE721;"
                                                   FontSize="24"
                                                   Margin="0,0,8,0"/>

                            <TextBlock Text="Explore"
                                       FontSize="20"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GlossySidebarButton}"
                            Margin="0,10,0,10" FontSize="28"
                            Click="NotificationButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE7EE;"
                                       FontSize="24"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="Notifications"
                                       FontSize="20"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GlossySidebarButton}"
                            Margin="0,10,0,10"
                            Click="ProfileButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE77B;"
                                       FontSize="22"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="Profile"
                                       FontSize="20"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlossySidebarButton}"
                            Margin="0,10,0,10"
                            Click="CollectionButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE14C;"
                                       FontSize="24"
                                       Margin="0,5,8,0"/>

                            <TextBlock Text="Collections"
                                       FontSize="20"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlossySidebarButton}"
                            Margin="0,10,0,10"
                            Click="UploadButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE898;"
                                       FontSize="24"
                                       Margin="0,3,8,0"/>

                            <TextBlock Text="Uploads"
                                       FontSize="20"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Row="2"
                    Style="{StaticResource LogoutButtonStyle}"
                    Width="150"
                    Height="40"
                    Click="LogoutButton_Click">
                    <TextBlock Text="Logout"
                           FontSize="16"
                           FontWeight="SemiBold"/>
                </Button>

            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox"
                     Style="{StaticResource ChromeSearchBox}" 
                     Width="400" 
                     Height="40" 
                     VerticalAlignment="Center"
                     KeyDown="SearchBox_KeyDown"/>
                <Grid Grid.Row="1"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Stretch">
                    <Border Background="Black"
                            CornerRadius="3"
                            ClipToBounds="True"
                            MaxHeight="450"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                        <vlc:VideoView x:Name="VideoPlayer"
                                       Height="600"
                                       Width="900"/>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="2"
                              Margin="10,30,10,10">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ChromeScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>

                        <TextBlock Text="Comments"
                               FontSize="20"
                               Foreground="White"
                               Margin="10,10,10,10"/>

                        <TextBox x:Name="CommentInputBox"
                             Style="{StaticResource LumentraInput}"
                             Width="Auto"
                             Height="40"
                             VerticalAlignment="Center"
                             Margin="10,0,10,10"/>

                        <Border Background="#222" 
        CornerRadius="15" 
        Padding="15" 
        Margin="0,5,0,5"
        HorizontalAlignment="Stretch">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <!-- Avatar -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Text Content -->
                                </Grid.ColumnDefinitions>

                                <!-- 1. Avatar -->
                                <Border Width="40" Height="40" 
                                    CornerRadius="20" 
                                    VerticalAlignment="Top" 
                                    ClipToBounds="True"
                                    BorderBrush="#444"
                                    BorderThickness="1">
                                    <Image Source="/lumentra;component/Assets/Images/UserIcon.png" Stretch="UniformToFill"/>
                                </Border>

                                <!-- 2. Comment Info -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="User123" 
                                                   Foreground="White" 
                                                   FontWeight="Bold" 
                                                   FontSize="14"/>
                                        <TextBlock Text="• 2 hours ago" 
                                                   Foreground="Gray" 
                                                   FontSize="12" 
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- The Actual Comment -->
                                    <TextBlock Text="This video was amazing! Can't wait for the next upload in the series." 
                                            Foreground="#CCC" 
                       FontSize="13" 
                       TextWrapping="Wrap" 
                       Margin="0,5,0,10"
                       LineHeight="18"/>

                                    <!-- Action Row -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Reply" 
                                                Foreground="#FF4169E1" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                FontSize="12" 
                                                FontWeight="SemiBold"
                                                Cursor="Hand"/>

                                        <TextBlock Text="&#xE19F;" 
                                                   FontFamily="Segoe MDL2 Assets" 
                                                   Foreground="Gray" 
                                                   Margin="20,0,5,0" 
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="24" Foreground="Gray" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                
            </Grid>
            <Grid Grid.Column="2">
                <Border CornerRadius="10"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Margin="8"
                    MaxHeight="800">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF1A1A1A" Offset="0.0"/>
                            <GradientStop Color="#FF121212" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <!-- Chat History (Scrollable) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Input Area -->
                        </Grid.RowDefinitions>

                        <!-- 1. Chat History Area -->
                        <ScrollViewer Grid.Row="0" Margin="10">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ChromeScrollBar}"/>
                            </ScrollViewer.Resources>
                            <StackPanel x:Name="ChatMessagesStackPanel" Orientation="Vertical">
                                <TextBlock Text="Chat Messages will appear here..."
                                       Foreground="Gray"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       Margin="5"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 2. Chat Input Area -->
                        <Border Grid.Row="1" Margin="15,0,15,15" Padding="5" 
                                Background="#252525" CornerRadius="25" 
                                BorderBrush="#333" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- The Input Text Box -->
                                <TextBox x:Name="ChatInputTextBox"
                             Style="{StaticResource LumentraInput}" 
                             Background="Transparent"
                             BorderThickness="0"
                             Tag="Message Gemini..."
                             Foreground="White"
                             CaretBrush="#FF4169E1"
                             Margin="5,0,0,0"
                             Padding="10,8"/>

                                <!-- Send Button (Uses your existing LogoutButtonStyle look) -->
                                <Button Grid.Column="1"
                            Content="&#xE72B;" 
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource LogoutButtonStyle}"
                            Width="10" Height="40"
                            Margin="0,0,5,0"
                            Click="SendButton_Click"
                            Visibility="Collapsed">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <!-- Make the button inside the template a perfect circle -->
                                            <Setter Property="CornerRadius" Value="20"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="1"
            CornerRadius="20"
            Margin="0,0,0,10"
            MaxHeight="70">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF4169E1" Offset="0.0"/>
                    <!-- Royal Blue -->
                    <GradientStop Color="#FFF34F67" Offset="1.0"/>
                    <!-- Blue Violet -->
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Now Playing"
                           VerticalAlignment="Top"
                           FontSize="16"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           Foreground="GhostWhite"
                           Margin="15,5,0,0"/>
                    <TextBlock Text="Learn C# - Bro Code"
                           Margin="15,5,0,0"
                           FontFamily="Segoe UI"
                           FontWeight="ExtraBold"
                           Foreground="Black"
                           FontSize="20"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Seek Left (Back 10s) -->
                    <Button Content="&#xE892;" Style="{StaticResource GlassPlaybackButton}"
                            Click="SeekLeft_Click"/>

                    <!-- Pause Button (Larger) -->
                    <Button x:Name="PauseButton" 
                        Content="&#xE769;" 
                        Style="{StaticResource GlassPlaybackButton}" 
                        Width="60" Height="60" FontSize="24"
                        Click="Pause_Click">
                        <Button.Resources>
                            <!-- Overriding radius for the larger play button -->
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="30"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Seek Right (Forward 10s) -->
                    <Button Content="&#xE893;" Style="{StaticResource GlassPlaybackButton}"
                            FontFamily="Segoe MDL2 Assets"
                            Click="SeekRight_Click"/>
                </StackPanel>
            </Grid>


        </Border>
    </Grid>

</Window>
