<Window x:Class="lumentra.View.ExploreView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:UserControl="clr-namespace:lumentra.View.UserControl"
        xmlns:local="clr-namespace:lumentra.View"
        mc:Ignorable="d"
        ThemeMode ="Dark"
        WindowState="Maximized"
        Title="ExploreView" Height="450" Width="800">

    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>

        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="360"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            Margin="10,0,0,0">
                    <Image Source="/lumentra;component/Assets/Images/LogoModified.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="15,0,5,0"
                           Height="30"/>
                    <TextBlock Text="lumentra"
                               VerticalAlignment="Center"
                               FontSize="30"
                               FontStyle="Italic"
                               FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF4169E1" Offset="0.0"/>
                                <!-- Royal Blue -->
                                <GradientStop Color="#FF8A2BE2" Offset="1.0"/>
                                <!-- Blue Violet -->
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>



                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,60,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE80F;"
                                           FontSize="24"
                                           Margin="0,0,8,0"/>

                            <TextBlock Text="Home"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE721;"
                                                       FontSize="24"
                                                       Margin="0,0,8,0"/>

                            <TextBlock Text="Explore"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10" FontSize="28">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE7EE;"
                                           FontSize="24"
                                           Margin="0,0,8,0"/>

                            <TextBlock Text="Notifications"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE77B;"
                                           FontSize="22"
                                           Margin="0,0,8,0"/>

                            <TextBlock Text="Profile"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE14C;"
                                           FontSize="24"
                                           Margin="0,5,8,0"/>

                            <TextBlock Text="Collections"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GlossySidebarButton}"
                                Margin="0,10,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE898;"
                                           FontSize="24"
                                           Margin="0,3,8,0"/>

                            <TextBlock Text="Uploads"
                                           FontSize="20"
                                           FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Row="2"
                        Style="{StaticResource LogoutButtonStyle}"
                        Width="150"
                        Height="40">
                    <TextBlock Text="Logout"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                </Button>

            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox Style="{StaticResource ChromeSearchBox}" 
                         Width="400" 
                         Height="40" 
                         VerticalAlignment="Center"/>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="4*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Button Style="{StaticResource CategoryButtonStyle}"
                                Content="Photography"
                                Height="60"
                                Width="200"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                Margin="10,10,10,10"/>
                        <Button Style="{StaticResource CategoryButtonStyle}"
                                Content="Photography"
                                Height="60"
                                Width="200"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                Margin="10,10,10,10"/>
                        <Button Style="{StaticResource CategoryButtonStyle}"
                                Content="Photography"
                                Height="60"
                                Width="200"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                Margin="10,10,10,10"/>
                        <Button Style="{StaticResource CategoryButtonStyle}"
                                Content="Photography"
                                Height="60"
                                Width="200"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                Margin="10,10,10,10"/>
                        <Button Style="{StaticResource CategoryButtonStyle}"
                                Content="Photography"
                                Height="60"
                                Width="200"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                Margin="10,10,10,10"/>
                        <Button Style="{StaticResource CategoryButtonStyle}"
                                Content="Photography"
                                Height="60"
                                Width="200"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                Margin="10,10,10,10"/>
                        <Button Style="{StaticResource CategoryButtonStyle}"
                                Content="Photography"
                                Height="60"
                                Width="200"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                Margin="10,10,10,10"/>
                        <Button Style="{StaticResource CategoryButtonStyle}"
                                Content="Photography"
                                Height="60"
                                Width="200"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                Margin="10,10,10,10"/>
                        <Button Style="{StaticResource CategoryButtonStyle}"
                                Content="Photography"
                                Height="60"
                                Width="200"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                Margin="10,10,10,10"/>
                        <Button Style="{StaticResource CategoryButtonStyle}"
                                Content="Photography"
                                Height="60"
                                Width="200"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                Margin="10,10,10,10"/>

                    </WrapPanel>

                    <Grid Grid.Row="1">
                        
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
