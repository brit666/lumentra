<Window x:Class="lumentra.View.AdminPanelView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lumentra.View"
        mc:Ignorable="d"
        Title="AdminPanelView" Height="450" Width="800"
        Background="#1A1A1A"
        ThemeMode="Dark"
        WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#121212">
            <StackPanel Margin="20">
                <TextBlock Text="LUMENTRA" Foreground="#FF4169E1" FontWeight="Black" FontSize="22" Margin="10,20,0,40"/>

                <RadioButton Content="User Management" Style="{StaticResource NavTabButtonStyle}" Tag="&#xE77B;" IsChecked="True"/>
                <RadioButton Content="Video Library" Style="{StaticResource NavTabButtonStyle}" Tag="&#xE714;"/>
                <RadioButton Content="Revenue" Style="{StaticResource NavTabButtonStyle}" Tag="&#xE9D2;"/>

                <Separator Background="#333" Margin="0,30"/>
                <Button Content="Logout" Style="{StaticResource LogoutButtonStyle}" Width="180"
                        FontSize="16"
                        Click="LogoutButton_Click"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Custom Table -->
            </Grid.RowDefinitions>

            <!-- HEADER AREA -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="User Management" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Overview of all registered creators and viewers" Foreground="Gray" FontSize="14"/>
                </StackPanel>
                <Button Content="+ Create New" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Style="{StaticResource LogoutButtonStyle}" Width="130" Height="40"/>
            </Grid>

            <!-- PLAIN TABLE (Manual Rows) -->
            <Border Grid.Row="1" Background="#252525" CornerRadius="20" Padding="20">
                <StackPanel>
                    <!-- Table Header -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AVATAR" Foreground="Gray" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="NAME" Foreground="Gray" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="STATUS" Foreground="Gray" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="ACTION" Foreground="Gray" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                    </Grid>

                    <Separator Background="#333" Margin="0,0,0,15"/>

                    <!-- ROW 1 (Manual) -->
                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="35" Height="35" Fill="#444" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="Alex (Creator)" Foreground="White" VerticalAlignment="Center" FontSize="15"/>
                        <Border Grid.Column="2" Background="#2000FF00" CornerRadius="10" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE" Foreground="LimeGreen" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="Gray" Background="Transparent" BorderThickness="0" FontSize="16" Margin="5"/>
                            <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#FFF34F67" Background="Transparent" BorderThickness="0" FontSize="16" Margin="5"/>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 2 (Manual) -->
                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="35" Height="35" Fill="#444" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="1" Text="Mike (User)" Foreground="White" VerticalAlignment="Center" FontSize="15"/>
                        <Border Grid.Column="2" Background="#20FFD700" CornerRadius="10" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="PENDING" Foreground="Gold" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="Gray" Background="Transparent" BorderThickness="0" FontSize="16" Margin="5"/>
                            <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#FFF34F67" Background="Transparent" BorderThickness="0" FontSize="16" Margin="5"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
