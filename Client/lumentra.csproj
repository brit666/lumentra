    <None Remove="Assets\Images\LumentraFeedBanner.png" />
    <None Remove="Assets\Images\PasswordIcon.png" />
    <None Remove="Assets\Images\UserIcon.png" />
    <None Remove="FeedVideos.json" />
    <None Remove="Notification.json" />
    <None Remove="VideoThumbnails\csharpVideo.jpg" />
