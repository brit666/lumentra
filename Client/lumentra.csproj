<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="AppSettings.json" />
    <None Remove="Assets\Images\AbstractLogo.png" />
    <None Remove="Assets\Images\AbstractLogoPNG.png" />
    <None Remove="Assets\Images\EmailIcon.png" />
    <None Remove="Assets\Images\Feedbanner.jpg" />
